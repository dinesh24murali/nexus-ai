# Environment Variables — copy to .env and fill in values
# Never commit .env to version control

# App
APP_ENV=development
APP_PORT=8000
APP_SECRET=changeme
# invite (default) requires an invite code to register; open disables the check
REGISTRATION_MODE=invite

# Database (psycopg 3 is the only driver)
DATABASE_URL=postgresql+psycopg://nexus:nexus@localhost:5432/nexus
# Used by the Postgres container and to build DATABASE_URL inside Compose. In production set a
# strong hex password (`openssl rand -hex 24`): it is placed in a URL, so avoid special characters.
POSTGRES_USER=nexus
POSTGRES_PASSWORD=nexus
POSTGRES_DB=nexus
# Host ports Compose publishes on 127.0.0.1 (change if something else already uses them, e.g. a
# local Postgres on 5432; then point DATABASE_URL at the new port for backend-only development).
# POSTGRES_PORT=5432
# QDRANT_PORT=6333
LANGGRAPH_STRICT_MSGPACK=true

# Auth
# JWT signing secret (generate with: openssl rand -hex 32)
AUTH_SECRET=

# ── AI / LLM ──
# real | fake (scripted fake model for tests and offline work; refused when APP_ENV=production)
LLM_MODE=real
# Seconds between streamed words in fake mode (e2e tests use ~0.03 so Stop can be pressed mid-answer)
LLM_FAKE_TOKEN_DELAY_S=0
OPENAI_API_KEY=
# Models and reasoning effort per role (docs/02_outputs/08_ai_system_design.md §3)
LLM_CHAT_MODEL=gpt-6.1-terra
LLM_CHAT_REASONING_EFFORT=low
LLM_FALLBACK_MODEL=gpt-6-luna
LLM_BACKGROUND_MODEL=gpt-6-luna
LLM_JUDGE_MODEL=gpt-5.5-2026-04-23
LLM_EMBEDDING_MODEL=text-embedding-3-small
LLM_MODERATION_MODEL=omni-moderation-latest
LLM_REQUEST_TIMEOUT_S=60
LLM_MAX_RETRIES=2
# v1.1 roles: intent router and long-form (documents, research reports); the router's min_confidence lives in backend/prompts/nexus.route.md
LLM_ROUTER_MODEL=gpt-6-luna
LLM_LONG_FORM_MODEL=gpt-6.1-terra
LLM_LONG_FORM_REASONING_EFFORT=medium

# Vector DB
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# LLM observability (Langfuse Cloud, EU region; or http://localhost:3000 with the optional self-hosted profile)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Tools
TAVILY_API_KEY=

# Budgets (USD per UTC day)
USER_DAILY_BUDGET_USD=0.50
GLOBAL_DAILY_BUDGET_USD=5.00

# Kill switches: boot defaults only. At runtime they live in the runtime_flags table:
#   python -m app.cli flags set TOOLS_DISABLED=web_search   (takes effect within 60 s, no restart)
TOOLS_DISABLED=
MEMORY_WRITES_DISABLED=0
READ_ONLY_MODE=0
CHAT_MODEL_OVERRIDE=
# v1.1
ROUTER_DISABLED=0
INTENTS_DISABLED=

# Set to true ONLY when every request reaches the API through Caddy (Compose does this itself);
# it makes rate limits use the client IP from X-Forwarded-For. Leave false when exposing the API directly.
# TRUSTED_PROXY=false

# Reverse proxy. Leave unset locally (HTTP on CADDY_HTTP_PORT); on the VM set the public domain
# and Caddy obtains a certificate automatically.
# SITE_ADDRESS=app.example.com
# CADDY_HTTP_PORT=8080

# External services
# Add project-specific keys below
