# Environment Variables — copy to .env and fill in values
# Never commit .env to version control

# App
APP_ENV=development
APP_PORT=8000
APP_SECRET=changeme

# Database
DATABASE_URL=

# Auth
# JWT signing secret (generate with: openssl rand -hex 32)
AUTH_SECRET=

# ── AI / LLM (remove if the project has no AI features) ──
# Provider
OPENAI_API_KEY=
LLM_CHAT_MODEL=
LLM_FAST_MODEL=
LLM_EMBEDDING_MODEL=
LLM_REQUEST_TIMEOUT_S=60
LLM_MAX_RETRIES=2

# Vector DB
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# LLM observability (Langfuse)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000

# Tools
TAVILY_API_KEY=

# Budgets
USER_DAILY_TOKEN_BUDGET=200000

# External services
# Add project-specific keys below
